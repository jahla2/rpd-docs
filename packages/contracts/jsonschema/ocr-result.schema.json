{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpd.local/contracts/ocr-result.schema.json",
  "title": "Normalized OCR Result",
  "type": "object",
  "required": ["schema_version", "document_id", "page", "engine", "blocks"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "document_id": {"type": "string"},
    "page": {"type": "integer", "minimum": 1},
    "engine": {"type": "string"},
    "model": {"type": ["string", "null"]},
    "image_width": {"type": ["integer", "null"]},
    "image_height": {"type": ["integer", "null"]},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_id", "text", "bbox", "confidence"],
        "properties": {
          "block_id": {"type": "string"},
          "text": {"type": "string"},
          "bbox": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 8
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
