APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://rpd:rpd@localhost:5432/rpd?sslmode=disable
NATS_URL=nats://localhost:4222
STORAGE_ROOT=./storage
AI_ENGINE_URL=http://localhost:8000
NATIVE_ENGINE_PATH=./build/native-engine/rpd-native-engine
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# API authentication. Keep disabled only for local development.
AUTH_MODE=disabled
API_KEY_PEPPER=
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Persistent artifact storage: local or s3.
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CREATE_BUCKET=false

# Selective agentic fallback in the Go orchestrator.
AGENT_FALLBACK_ENABLED=false
AGENT_MIN_CONFIDENCE=0.90

# Python AI engine agent provider: disabled, ollama, or openai_compatible.
AGENT_PROVIDER=disabled
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=

# Local document classification. Rules are the zero-download fast path.
# Set backend=modernbert after running scripts/models/download_modernbert.py.
DOCUMENT_CLASSIFIER_BACKEND=rules
DOCUMENT_CLASSIFIER_MODEL_DIR=/models/modernbert
DOCUMENT_CLASSIFIER_MODEL_FILE=onnx/model_int8.onnx
DOCUMENT_CLASSIFIER_PROVIDER=cpu
DOCUMENT_CLASSIFIER_MAX_LENGTH=256
DOCUMENT_CLASSIFIER_RULE_THRESHOLD=0.90
DOCUMENT_CLASSIFIER_MODEL_THRESHOLD=0.72
DOCUMENT_CLASSIFIER_MODEL_MARGIN=0.08
DOCUMENT_CLASSIFIER_MODEL_VERSION=modernbert-base-zeroshot-v2.0-int8
